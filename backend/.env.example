DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Neon: copy host/user/password/dbname from the Neon dashboard connection details
DB_NAME=neondb
DB_USER=change-me
DB_PASSWORD=change-me
DB_HOST=ep-xxxx.region.aws.neon.tech
DB_PORT=5432
DB_SSLMODE=require

# Random string that is part of the M-Pesa callback URLs (/api/v1/mpesa/c2b/<secret>/confirmation/)
MPESA_CALLBACK_SECRET=change-me-to-a-long-random-string
MPESA_PAYBILL=
# Minutes an access token stays valid
JWT_ACCESS_MINUTES=60
