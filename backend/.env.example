DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Neon: copy host/user/password/dbname from the Neon dashboard connection details
DB_NAME=neondb
DB_USER=change-me
DB_PASSWORD=change-me
DB_HOST=ep-xxxx.region.aws.neon.tech
DB_PORT=5432
DB_SSLMODE=require

# Random string that is part of the M-Pesa callback URLs (/api/v1/mpesa/c2b/<secret>/confirmation/)
MPESA_CALLBACK_SECRET=change-me-to-a-long-random-string
MPESA_PAYBILL=
# Minutes an access token stays valid
JWT_ACCESS_MINUTES=60

# Text messages: leave SMS_PROVIDER=console to only log them, or africastalking to really send
SMS_PROVIDER=console
AT_USERNAME=sandbox
AT_API_KEY=
AT_SENDER_ID=

# Daraja (real M-Pesa). Get these from https://developer.safaricom.co.ke (Go Live for production)
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_PASSKEY=
# This server's public https address, e.g. https://api.youragency.co.ke
MPESA_PUBLIC_URL=
